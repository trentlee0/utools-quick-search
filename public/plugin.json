{
  "name": "Quick Opener",
  "pluginName": "Quick Opener",
  "description": "通过 URL 快速搜索、打开网页和应用",
  "version": "1.0.0",
  "author": "Trent0",
  "homepage": "https://github.com/trentlee0",
  "logo": "logo.png",
  "main": "index.html",
  "preload": "preload.js",
  "development": {
    "main": "http://127.0.0.1:5173/"
  },
  "features": [
    {
      "code": "open-url",
      "explain": "默认应用打开 URL",
      "cmds": [
        {
          "type": "regex",
          "label": "打开 URL",
          "match": "/^[a-z\\-A-Z]+:\/\/(.+)$/"
        }
      ]
    },
    {
      "code": "add-item",
      "explain": "添加项目",
      "cmds": [
        "Add Item",
        "添加项目",
        {
          "type": "window",
          "label": "添加当前网址",
          "match": {
            "app": [
              "Safari.app",
              "Google Chrome.app",
              "Microsoft Edge.app",
              "Opera.app",
              "Vivaldi.app",
              "Brave Browser.app",
              "Zen.app",
              "chrome.exe",
              "firefox.exe",
              "msedge.exe",
              "opera.exe",
              "brave.exe"
            ]
          }
        }
      ]
    },
    {
      "code": "quick-opener",
      "explain": "Quick Opener 设置",
      "cmds": [
        "Quick Opener",
        "Quick Opener Setting",
        "Quick Opener 设置"
      ]
    }
  ]
}